<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetroShowroom.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:RetroShowroom"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Padding="28,4,28,28" Spacing="10">
            <Grid Margin="0,4,0,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{l:Tr De='Einrichtung', En='Setup'}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="{l:Tr De='Prüft, ob alles zum Rendern bereit ist. Dafür wird Blender kurz im Hintergrund gestartet.', En='Checks whether everything is ready for rendering. Blender is started briefly in the background for this.'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing x:Name="CheckRing" IsActive="False" Width="20" Height="20" />
                    <Button x:Name="RecheckButton" Click="Recheck_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{l:Tr De='Erneut prüfen', En='Check again'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="SummaryBar" IsOpen="True" IsClosable="False" />
            <InfoBar x:Name="ActionInfoBar" IsClosable="True" />

            <!-- Blender -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="BlenderIcon" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{l:Tr De='Blender 4.2 oder neuer', En='Blender 4.2 or newer'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="BlenderDetail" Style="{StaticResource HintTextStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="InstallBlenderButton" Content="{l:Tr De='Installieren', En='Install'}" Click="InstallBlender_Click"
                                ToolTipService.ToolTip="{l:Tr De='Installiert Blender über winget (Windows-Paketmanager)', En='Installs Blender via winget (Windows package manager)'}" />
                        <Button Content="{l:Tr De='Pfad wählen …', En='Choose path …'}" Click="PickBlender_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sollumz -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SollumzIcon" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{l:Tr De='Sollumz (Blender-Erweiterung für GTA-V-Dateien)', En='Sollumz (Blender extension for GTA V files)'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SollumzDetail" Style="{StaticResource HintTextStyle}" IsTextSelectionEnabled="True" />
                        <StackPanel x:Name="SollumzSteps" Spacing="2">
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="{l:Tr De='1. Sollumz als ZIP herunterladen (getestet mit 2.9.0).', En='1. Download Sollumz as a ZIP (tested with 2.9.0).'}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="{l:Tr De='2. Blender öffnen → Bearbeiten → Einstellungen → Erweiterungen → Pfeil oben rechts → „Von Datei installieren …“ → ZIP wählen.', En='2. Open Blender → Edit → Preferences → Get Extensions → arrow at the top right → Install from Disk … → choose the ZIP.'}" />
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="{l:Tr De='3. In den Sollumz-Einstellungen die PyMateria-Lizenz von Cfx.re annehmen.', En='3. Accept the PyMateria license from Cfx.re in the Sollumz preferences.'}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Content="{l:Tr De='Sollumz herunterladen', En='Download Sollumz'}" Click="SollumzDownload_Click" />
                        <Button Content="{l:Tr De='Blender öffnen', En='Open Blender'}" Click="OpenBlender_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Skelette -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="SkeletonIcon" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{l:Tr De='Freemode-Skelette (männlich und weiblich)', En='Freemode skeletons (male and female)'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SkeletonDetail" Style="{StaticResource HintTextStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="SkeletonSteps" Style="{StaticResource HintTextStyle}"
                                   Text="{l:Tr De='In Blender: Bearbeiten → Einstellungen → Erweiterungen → Sollumz → „Add MP Freemode Skeletons from Game Files“ und den GTA-V-Installationsordner wählen.', En='In Blender: Edit → Preferences → Extensions → Sollumz → Add MP Freemode Skeletons from Game Files, then choose the GTA V install folder.'}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:Tr De='Blender öffnen', En='Open Blender'}" Click="OpenBlender_Click" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Grafikkarte -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="GpuIcon" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{l:Tr De='Grafikkarte zum Rendern', En='Graphics card for rendering'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="GpuDetail" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:Tr De='Einstellungen', En='Settings'}" Click="OpenSettings_Click" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <TextBlock Text="Assets" Style="{StaticResource SectionHeaderStyle}" />

            <!-- Logo -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="LogoIcon" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Logo (retro_logo_glas.png)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="LogoDetail" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:Tr De='In den Einstellungen hinzufügen', En='Add in the settings'}" Click="OpenSettings_Click" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Referenzbild -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="RefIcon" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{l:Tr De='Referenzbild (optional)', En='Reference image (optional)'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="RefDetail" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{l:Tr De='In den Einstellungen hinzufügen', En='Add in the settings'}" Click="OpenSettings_Click" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
