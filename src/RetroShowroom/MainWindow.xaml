<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RetroShowroom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:RetroShowroom"
    Title="Retro Showroom">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Eigene Titelleiste -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Width="20" Height="20" />

                <TextBlock Text="Retro Showroom" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleStatus" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="210"
            Loaded="Nav_Loaded"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{l:Tr De='Rendern', En='Render'}" Tag="render">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Tr De='Einrichtung', En='Setup'}" Tag="setup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="SetupBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hinweis auf Updates, über jeder Seite sichtbar -->
                <InfoBar x:Name="UpdateBar" Margin="28,8,28,4" Visibility="Collapsed" Closed="UpdateBar_Closed">
                    <InfoBar.ActionButton>
                        <Button x:Name="UpdateBarButton" Click="UpdateBarButton_Click" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <ProgressBar x:Name="UpdateBarProgress" Minimum="0" Maximum="100" Margin="0,0,16,14" Visibility="Collapsed" />
                    </InfoBar.Content>
                </InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
